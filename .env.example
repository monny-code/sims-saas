PORT=4000
JWT_SECRET=change-this-secret-in-production
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173,https://aa3d9d4b.sims-saas.pages.dev
APP_NAME=SIMS
APP_URL=http://localhost:4000

# Supabase settings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_PUBLISHABLE_KEY=your-anon-key
SUPABASE_SECRET_KEY=your-service-role-key
# Optional: only enable demo data seeding for a disposable development project.
SEED_DEMO_DATA=false
# The service-role key is server-only; it is required for school-admin user creation.
# Access tokens are verified server-side with Supabase Auth's getUser endpoint.

# Legacy Firebase settings intentionally disabled.
USE_FIREBASE=false
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_SERVICE_ACCOUNT=
